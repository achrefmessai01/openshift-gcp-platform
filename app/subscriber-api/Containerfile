# Red Hat UBI 9 Python image: supported base on OpenShift, non-root by default (UID 1001),
# application root owned by group 0 so the container also runs under an arbitrary UID
# assigned by the restricted-v2 SCC.
FROM registry.access.redhat.com/ubi9/python-311:latest

LABEL org.opencontainers.image.title="subscriber-api" \
      org.opencontainers.image.description="Subscriber provisioning API (reference workload)" \
      org.opencontainers.image.source="https://github.com/achrefmessai01/openshift-gcp-platform" \
      org.opencontainers.image.licenses="MIT" \
      io.openshift.expose-services="8080:http" \
      io.k8s.display-name="subscriber-api"

ARG APP_VERSION=0.1.0
ENV APP_VERSION=${APP_VERSION} \
    PORT=8080 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DEFAULT_TIMEOUT=100

# WORKDIR is /opt/app-root/src in this image; keep the default.
COPY --chown=1001:0 requirements.txt pyproject.toml README.md ./
COPY --chown=1001:0 src/ ./src/

RUN pip install --no-cache-dir -r requirements.txt . \
    && chgrp -R 0 /opt/app-root \
    && chmod -R g=u /opt/app-root

EXPOSE 8080
USER 1001

CMD ["sh", "-c", "exec uvicorn subscriber_api.main:app --host 0.0.0.0 --port ${PORT} --proxy-headers --forwarded-allow-ips='*' --timeout-graceful-shutdown 20"]
