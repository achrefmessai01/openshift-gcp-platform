global:
  resolve_timeout: 5m
route:
  group_by: [namespace, alertname]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: platform-webhook
  routes:
    - matchers:
        - alertname = Watchdog
      receiver: "null"
    - matchers:
        - severity = critical
      receiver: platform-webhook
      repeat_interval: 1h
receivers:
  - name: "null"
  - name: platform-webhook
    webhook_configs:
      - url: {{ monitoring.alertmanager_webhook_url }}
        send_resolved: true
