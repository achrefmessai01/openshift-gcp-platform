apiVersion: v1
kind: ServiceAccount
metadata:
  name: filebeat
  namespace: {{ logging.namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: filebeat-autodiscover
rules:
  - apiGroups: [""]
    resources: [namespaces, pods, nodes]
    verbs: [get, list, watch]
  - apiGroups: [apps]
    resources: [replicasets]
    verbs: [get, list, watch]
  - apiGroups: [batch]
    resources: [jobs]
    verbs: [get, list, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: filebeat-autodiscover
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: filebeat-autodiscover
subjects:
  - kind: ServiceAccount
    name: filebeat
    namespace: {{ logging.namespace }}
---
# Reading /var/log on the nodes needs the privileged SCC; granted through the built-in
# system:openshift:scc:privileged ClusterRole rather than by editing the SCC itself.
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: filebeat-scc-privileged
  namespace: {{ logging.namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: system:openshift:scc:privileged
subjects:
  - kind: ServiceAccount
    name: filebeat
    namespace: {{ logging.namespace }}
