apiVersion: kibana.k8s.elastic.co/v1
kind: Kibana
metadata:
  name: logging
  namespace: {{ logging.namespace }}
spec:
  version: "{{ logging.version }}"
  count: 1
  elasticsearchRef:
    name: logging
  http:
    tls:
      # The OpenShift Route terminates TLS with the cluster ingress certificate.
      selfSignedCertificate:
        disabled: true
  podTemplate:
    spec:
      containers:
        - name: kibana
          resources:
            requests:
              cpu: 250m
              memory: 1Gi
            limits:
              memory: 1Gi
