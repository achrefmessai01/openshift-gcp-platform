# Copy to terraform.tfvars (git-ignored) and adjust.
project_id  = "my-gcp-project"
region      = "europe-west1"
zone        = "europe-west1-b"
name        = "ocp"
base_domain = "ocp.example.com"

# Who may reach the OpenShift API: office egress, VPN concentrator, CI runners.
admin_cidrs = ["203.0.113.0/24", "198.51.100.17/32"]

create_dns_zone  = true
create_bastion   = false
enable_flow_logs = true

labels = {
  owner       = "platform-team"
  managed-by  = "terraform"
  application = "openshift"
  cost-center = "integration"
}
