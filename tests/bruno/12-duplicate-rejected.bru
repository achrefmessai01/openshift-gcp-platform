meta {
  name: 12 Duplicate is rejected
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/subscribers
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "msisdn": "{{msisdn}}",
    "plan": "PREPAID_5GB"
  }
}

tests {
  test("duplicate returns 409 with a problem body", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().title).to.equal("subscriber already exists");
  });
}
